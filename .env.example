# UADA Environment Configuration
# ================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── DATABASE (REQUIRED) ──────────────────────────────────────────────────────
# The client database to connect to. Must be a read-only account.
# Examples:
#   PostgreSQL: postgresql://readonly:pass@localhost:5432/mydb
#   MySQL:      mysql+pymysql://readonly:pass@localhost:3306/mydb
#   SQLite:     sqlite:///./data/mydb.sqlite
#   SQL Server: mssql+pyodbc://readonly:pass@host/mydb?driver=ODBC+Driver+17+for+SQL+Server
UADA_DB_URL=postgresql://readonly_user:password@localhost:5432/your_database

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Local (zero cloud): ollama:qwen2.5-coder:7b (requires Ollama running)
# Cloud (high accuracy): claude-sonnet-4-6 (requires ANTHROPIC_API_KEY)
#                        openai:gpt-4o (requires OPENAI_API_KEY)
UADA_LLM_MODEL=ollama:qwen2.5-coder:7b

# If using Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# If using OpenAI:
# OPENAI_API_KEY=sk-...

# ── SEMANTIC CONTEXT LAYER ───────────────────────────────────────────────────
# Path to your SCL YAML file. Generate a candidate with:
#   python scripts/onboard_db.py
UADA_SCL_PATH=./config/semantic_context.yaml

# ── VECTOR STORE ─────────────────────────────────────────────────────────────
UADA_VECTOR_BACKEND=chroma
UADA_CHROMA_PATH=./data/chroma

# ── SECURITY ─────────────────────────────────────────────────────────────────
UADA_DB_QUERY_TIMEOUT_SECONDS=30
UADA_DB_MAX_ROWS=1000
UADA_SQL_MAX_SUBQUERY_DEPTH=3

# ── OBSERVABILITY ─────────────────────────────────────────────────────────────
UADA_LANGFUSE_HOST=http://localhost:3000
UADA_LANGFUSE_SECRET_KEY=sk-lf-...
UADA_LANGFUSE_PUBLIC_KEY=pk-lf-...

# ── API ───────────────────────────────────────────────────────────────────────
# Set to a secret value in production. Leave empty to disable auth (local dev only).
UADA_API_KEY=
UADA_API_PORT=8000
UADA_API_DEBUG=true
