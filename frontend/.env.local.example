# URL of the UADA FastAPI backend. The Next.js server proxies /api/backend/*
# to this URL so the browser never talks to the backend directly (no CORS
# config needed on the FastAPI side).
BACKEND_URL=http://localhost:8000

# Optional. Only set this if the backend was started with UADA_API_KEY set.
# It is attached server-side as "Authorization: Bearer <key>" and is never
# exposed to the browser.
BACKEND_API_KEY=
