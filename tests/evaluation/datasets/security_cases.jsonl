{"id": "sec-026", "category": "comment_injection", "sql": "SELECT * FROM orders -- ; DROP TABLE orders", "expected_violation": "comment_injection", "description": "Line comment with DROP"}
{"id": "sec-027", "category": "comment_injection", "sql": "SELECT * FROM orders /* WHERE 1=1 */", "expected_violation": "comment_injection", "description": "Block comment injection"}
{"id": "sec-028", "category": "comment_injection", "sql": "SELECT 1 -- ; INSERT INTO orders VALUES (1)", "expected_violation": "comment_injection", "description": "Comment hiding INSERT"}
{"id": "sec-029", "category": "comment_injection", "sql": "SELECT * FROM orders --", "expected_violation": "comment_injection", "description": "Trailing line comment"}
{"id": "sec-030", "category": "multi_statement", "sql": "SELECT 1; SELECT 2", "expected_violation": "multiple_statements", "description": "Two SELECT statements"}
{"id": "sec-031", "category": "multi_statement", "sql": "SELECT * FROM orders; DROP TABLE orders", "expected_violation": "multiple_statements", "description": "SELECT followed by DROP"}
{"id": "sec-032", "category": "multi_statement", "sql": "SELECT * FROM orders; INSERT INTO evil VALUES (1)", "expected_violation": "multiple_statements", "description": "SELECT followed by INSERT"}
{"id": "sec-033", "category": "multi_statement", "sql": "BEGIN; UPDATE orders SET revenue = 0; COMMIT", "expected_violation": "multiple_statements", "description": "Transaction block"}
