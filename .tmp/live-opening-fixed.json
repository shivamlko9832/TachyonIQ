  "sql": "SELECT STRFTIME('%Y-%m', wm_finance_monthly.month) AS period, SUM(wm_finance_monthly.revenue) AS waste_revenue, 100.0 * SUM(wm_finance_monthly.operating_profit) / NULLIF(SUM(wm_finance_monthly.revenue), 0) AS waste_operating_margin_pct FROM wm_finance_monthly WHERE wm_finance_monthly.month >= '2026-01-01' AND wm_finance_monthly.month < '2026-12-31' GROUP BY STRFTIME('%Y-%m', wm_finance_monthly.month) ORDER BY period LIMIT 5000",
